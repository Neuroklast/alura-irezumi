# No environment variables are required for demo mode.
# Explicitly use demo content even when integrations are configured:
DEMO_MODE=true

# Enable live content by setting DEMO_MODE=false and configuring Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed only for live enquiry ingestion, never for the public website.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: live admin uploads. Without R2, editing existing images still works.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Enable only after completing legal notices and retention configuration.
ENQUIRIES_ENABLED=false
# Random secret, at least 32 random bytes. Server-only HMAC key for rate limiting.
RATE_LIMIT_SECRET=
